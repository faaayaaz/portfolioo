# Optional. The form works as an email-draft composer without SMTP.
# Configure secrets privately on your production host; never commit .env.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SITE_URL=https://your-owned-domain
# VITE_SITE_URL should match SITE_URL when building for a custom domain.
# PORT=3001
